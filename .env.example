# AI concierge (server-only). Point at any OpenAI-compatible endpoint
# (self-hosted vLLM/Ollama, OpenAI, Groq, Together, Fireworks, a private
# gateway, etc.). REQUIRED for /api/chat to work; the app degrades gracefully
# and returns a 500 with a clear message if these are missing.
# AI_GATEWAY_BASE_URL="https://api.openai.com/v1"
# AI_GATEWAY_API_KEY=""
# AI_GATEWAY_MODEL="gpt-4o-mini"
# AI_GATEWAY_API_KEY_HEADER=""     # only if your gateway needs a custom header

# Nitro deployment preset (optional; defaults to `vercel` in vite.config.ts).
# NITRO_PRESET="vercel"
